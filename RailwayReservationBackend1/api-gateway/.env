# ============================================================
# API GATEWAY CONFIGURATION
# ============================================================

# Port on which the API Gateway runs
PORT=8080

# Environment mode (development / production)
NODE_ENV=development

# JWT Secret Key - used to verify incoming user tokens
# (Matches the base64-encoded secret key used by auth-service)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Secret Key encoding type: 'base64' or 'utf8'
JWT_SECRET_ENCODING=base64

# ============================================================
# BACKEND MICROSERVICES TARGET URLS
# ============================================================

# Authentication & Authorization Service (Spring Boot)
AUTH_SERVICE_URL=http://localhost:8081

# Train Management Service
TRAIN_SERVICE_URL=http://localhost:8082

# Ticket Booking Service
BOOKING_SERVICE_URL=http://localhost:8083

# User Management Service
USER_SERVICE_URL=http://localhost:8084

# Payment Service
PAYMENT_SERVICE_URL=http://localhost:8085

# Notification Service
NOTIFICATION_SERVICE_URL=http://localhost:8086
