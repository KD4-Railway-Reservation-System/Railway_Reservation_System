# ==========================================
# Railway Reservation System - Backend .gitignore
# ==========================================

# Java / Maven Build Artifacts
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Maven Wrapper binaries
!.mvn/wrapper/maven-wrapper.jar
!**/mvnw
!**/mvnw.cmd

# Node / API Gateway Dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and Secret Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!**/.env.example

# IDE and Editor Files
.idea/
.metadata/
*.iml
*.ipr
*.iws
.vscode/
.classpath
.project
.settings/
.factorypath

# OS and System Files
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*.swo
*~
*.tmp

# Logs
logs/
*.log
